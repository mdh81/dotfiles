font-family = Monaco
font-family = Symbols Nerd Font Mono
font-thicken = true
font-size = 15

theme = Rose Pine Moon
background-opacity = 0.95
background-blur = 20
window-padding-x = 12
window-padding-y = 12

# Keep remote SSH sessions compatible with hosts that only know xterm.
term = xterm

# WezTerm's Ctrl-T tab leader.
keybind = ctrl+t>h=previous_tab
keybind = ctrl+t>l=next_tab
keybind = ctrl+t>b=toggle_tab_overview
keybind = ctrl+t>r=prompt_tab_title
keybind = ctrl+t>n=new_tab
